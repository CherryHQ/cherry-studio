// Cherry Studio Zed Settings Example
//
// NOTE: Please install the Oxc extension.
//
// Folder-specific settings
//
// For a full list of overridable settings, and general information on folder-specific settings,
// see the documentation: https://zed.dev/docs/configuring-zed#settings-files
{
  "languages": {
    "JSON": {
      "format_on_save": "on",
      "formatter": {
        "language_server": {
          "name": "oxfmt"
        }
      }
    },
    "JSONC": {
      "format_on_save": "on",
      "formatter": {
        "language_server": {
          "name": "oxfmt"
        }
      }
    },
    "TSX": {
      "code_actions_on_format": {
        "source.fixAll.eslint": true,
        "source.fixAll.oxc": true
      },
      "format_on_save": "on",
      "formatter": {
        "language_server": {
          "name": "oxfmt"
        }
      }
    },
    "TypeScript": {
      "code_actions_on_format": {
        "source.fixAll.eslint": true,
        "source.fixAll.oxc": true
      },
      "format_on_save": "on",
      "formatter": {
        "language_server": {
          "name": "oxfmt"
        }
      }
    }
  },
  "lsp": {
    "oxfmt": {
      "initialization_options": {
        "settings": {
          "fmt.configPath": ".oxfmtrc.json",
          "run": "onSave"
        }
      }
    }
  }
}
