diff --git a/out/portableInstallScript.js b/out/portableInstallScript.js
new file mode 100644
index 0000000000000000000000000000000000000000..8c0eec02056c78de48e28b869ed1860d0a1597d7
--- /dev/null
+++ b/out/portableInstallScript.js
@@ -0,0 +1,44 @@
+"use strict";
+exports.portableInstallScript = String.raw`
+$ErrorActionPreference = 'Stop'
+$stage = $c.target + '.update-' + [Guid]::NewGuid().ToString() + '.exe'
+$backup = $stage + '.previous'
+$replaced = $false
+$ready = $false
+try {
+    $parentProcess = [Diagnostics.Process]::GetProcessById($c.parent)
+    Copy-Item -LiteralPath $c.source -Destination $stage
+    $hash = [Convert]::ToBase64String([Security.Cryptography.SHA512]::Create().ComputeHash([IO.File]::ReadAllBytes($stage)))
+    if ($hash -cne $c.sha512) { throw 'Portable SHA512 verification failed' }
+    $current = Get-AuthenticodeSignature -LiteralPath $c.target
+    $next = Get-AuthenticodeSignature -LiteralPath $stage
+    if ($current.Status -ne 'Valid' -or $next.Status -ne 'Valid' -or $current.SignerCertificate.Subject -cne $next.SignerCertificate.Subject) {
+        throw 'Portable publisher verification failed'
+    }
+    [Console]::Out.WriteLine('ready')
+    [Console]::Out.Flush()
+    $ready = $true
+    if (!$parentProcess.WaitForExit(120000)) { throw 'Application did not exit' }
+    $deadline = [DateTime]::UtcNow.AddSeconds(60)
+    while ($true) {
+        try { [IO.File]::Move($c.target, $backup); break }
+        catch { if ([DateTime]::UtcNow -ge $deadline) { throw }; Start-Sleep -Milliseconds 250 }
+    }
+    $replaced = $true
+    [IO.File]::Move($stage, $c.target)
+    Start-Process -FilePath $c.target -WorkingDirectory ([IO.Path]::GetDirectoryName($c.target))
+    Remove-Item -LiteralPath $backup -ErrorAction SilentlyContinue
+} catch {
+    $failure = $_.ToString()
+    if ($replaced) {
+        Remove-Item -LiteralPath $c.target -ErrorAction SilentlyContinue
+        [IO.File]::Move($backup, $c.target)
+        Start-Process -FilePath $c.target -WorkingDirectory ([IO.Path]::GetDirectoryName($c.target))
+    }
+    [IO.File]::WriteAllText($c.source + '.install-error.log', $failure)
+    if (!$ready) { [Console]::Error.WriteLine($failure) }
+    exit 1
+} finally {
+    Remove-Item -LiteralPath $stage -ErrorAction SilentlyContinue
+}
+`;
