+++ b/dist/nested-tool-records.js
@@ -0,0 +1,25 @@
+const encoder = new TextEncoder();
+export function retainNestedToolCall(previous, call) {
+    const record = previous ?? { version: 1, calls: [], complete: true };
+    const index = record.calls.findIndex((item) => item.id === call.id);
+    if (index < 0 && record.calls.length >= 256) {
+        return { ...record, complete: false, omittedCalls: (record.omittedCalls ?? 0) + 1 };
+    }
+    const next = JSON.parse(JSON.stringify(call));
+    for (const [field, perCall, total] of [["arguments", 8192, 32768], ["result", 65536, 1048576]]) {
+        if (next[field] === undefined) continue;
+        delete next[field + "Bytes"];
+        delete next[field + "Omitted"];
+        const bytes = encoder.encode(JSON.stringify(next[field])).length;
+        const used = record.calls.reduce((sum, item, i) => sum + (i === index || item[field] === undefined ? 0 : encoder.encode(JSON.stringify(item[field])).length), 0);
+        if (bytes > perCall || used + bytes > total) {
+            delete next[field];
+            next[field + "Bytes"] = bytes;
+            next[field + "Omitted"] = "budget";
+        }
+    }
+    const calls = record.calls.slice();
+    if (index < 0) calls.push(next);
+    else calls[index] = next;
+    return { ...record, version: 1, calls, complete: !record.omittedCalls && calls.every((item) => item.status !== "unfinished" && item.arguments !== undefined && item.result !== undefined) };
+}
