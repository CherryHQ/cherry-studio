@@ -0,0 +1,40 @@
+/** A detached single-response query. It owns no session, transcript, tools or durable tasks. */
+export function createQueryFork(model, messages, stream, options = {}) {
+    const snapshot = structuredClone(messages);
+    const parentRequestEnd = snapshot.findLastIndex(message => message.role === 'assistant');
+    return {
+        model,
+        messages: snapshot,
+        async query(prompt, signal) {
+            signal.throwIfAborted();
+            const controller = new AbortController();
+            const requestSignal = AbortSignal.any([signal, controller.signal]);
+            const context = { messages: [...structuredClone(snapshot), { role: 'user', content: prompt, timestamp: Date.now() }] };
+            const response = stream(model, context, {
+                ...options,
+                signal: requestSignal,
+                disableContinuation: true,
+                readOnlyFork: true,
+                skipCacheWrite: true,
+                cacheReadPrefix: Math.max(0, parentRequestEnd),
+            });
+            for await (const event of response) {
+                if (event.type === 'toolcall_start' || ('partial' in event && event.partial.content.some(part => part.type === 'toolCall'))) {
+                    controller.abort();
+                    return { calledTool: true, message: undefined };
+                }
+            }
+            const message = await response.result();
+            return { calledTool: message.content.some(part => part.type === 'toolCall'), message };
+        },
+    };
+}
+/** Claude's documented early-conversation and cold-cache gates, without private feature flags. */
+export function canSuggestPrompt(messages) {
+    const responses = messages.filter(message => message.role === 'assistant');
+    if (responses.length < 2) return false;
+    const last = responses.at(-1);
+    if (last.stopReason !== 'stop') return false;
+    const tokens = last.usage.input + last.usage.output;
+    return tokens <= 10000 && tokens + last.usage.cacheWrite <= 10000;
+}
