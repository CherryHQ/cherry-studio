@@ -0,0 +1,35 @@
+import { contentText } from "./text.js";
+import { estimateSystemCharacters } from "./estimate.js";
+export function measureSystemContext(system, deferred = [], estimate = estimateSystemCharacters, separator = "\n\n") {
+    const parts = [];
+    let promptCharacters = 0;
+    let measured = 0;
+    const addText = (id, value, source) => {
+        if (!value) return;
+        promptCharacters += (promptCharacters ? separator.length : 0) + value.length;
+        const next = estimate(promptCharacters, 0);
+        parts.push({ id, kind: source?.kind ?? "system-prompt", tokens: next - measured,
+            resources: source?.resources ?? [{ id, name: id, characters: value.length, source: source?.source }] });
+        measured = next;
+    };
+    if (system) {
+        addText("prompt", contentText(system.content));
+        for (const [key, value] of Object.entries(system.sections ?? {}))
+            addText(key, value, system.contextSources?.sections[key]);
+    }
+    for (const [state, tools] of [["loaded", system?.toolsAdded ?? []], ["deferred", deferred]]) {
+        let tokens = state === "loaded" ? measured : 0;
+        let schemaCharacters = 0;
+        for (const tool of tools) {
+            const declaration = { name: tool.name, description: tool.description, parameters: tool.parameters,
+                ...(tool.constrainedSampling === undefined ? {} : { constrainedSampling: tool.constrainedSampling }) };
+            schemaCharacters += JSON.stringify(declaration).length + (schemaCharacters ? 1 : 2);
+            const next = estimate(state === "loaded" ? promptCharacters : 0, schemaCharacters);
+            const source = state === "loaded" ? system?.contextSources?.tools[tool.name] : tool.contextSource;
+            parts.push({ id: tool.name, kind: source?.kind ?? "system-tools", tokens: next - tokens,
+                state, source: source?.source });
+            tokens = next;
+        }
+    }
+    return parts;
+}
