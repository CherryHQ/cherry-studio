@@ -94,7 +94,17 @@ var ReactChatState = class {
       ]);
       __privateGet(this, _callMessagesCallbacks).call(this);
     };
-    this.snapshot = (value) => structuredClone(value);
+    // PATCHED(cherry): structural-sharing snapshot (mirrors vercel/ai#18692) — the original
+    // structuredClone was O(message bytes) per chunk, melting long streams (vercel/ai#18624).
+    this.snapshot = (value) => {
+      if (!(value && Array.isArray(value.parts))) return structuredClone(value);
+      const snapshot = { ...value, parts: value.parts.map((part) => ({ ...part })) };
+      if ("metadata" in value) {
+        const metadata = value.metadata;
+        snapshot.metadata = Array.isArray(metadata) ? [...metadata] : metadata !== null && typeof metadata === "object" ? { ...metadata } : metadata;
+      }
+      return snapshot;
+    };
     this["~registerMessagesCallback"] = (onChange, throttleWaitMs) => {
       const callback = throttleWaitMs ? throttle(onChange, throttleWaitMs) : onChange;
       __privateGet(this, _messagesCallbacks).add(callback);
