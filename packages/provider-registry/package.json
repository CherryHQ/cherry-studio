{
  "name": "@cherrystudio/provider-registry",
  "version": "0.0.1-alpha.1",
  "private": true,
  "description": "Provider and Model Registry",
  "homepage": "https://github.com/CherryHQ/cherry-studio#readme",
  "bugs": {
    "url": "https://github.com/CherryHQ/cherry-studio/issues"
  },
  "license": "MIT",
  "author": "Cherry Studio",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CherryHQ/cherry-studio.git"
  },
  "files": [
    "dist/**/*",
    "data/**/*"
  ],
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      },
      "react-native": "./dist/index.cjs",
      "default": "./dist/index.mjs"
    },
    "./node": {
      "import": {
        "types": "./dist/registry-loader.d.mts",
        "default": "./dist/registry-loader.mjs"
      },
      "require": {
        "types": "./dist/registry-loader.d.cts",
        "default": "./dist/registry-loader.cjs"
      },
      "default": "./dist/registry-loader.cjs"
    }
  },
  "scripts": {
    "build": "tsdown",
    "clean": "rm -rf dist",
    "dev": "pnpm --workspace-root exec tsc -w -p packages/provider-registry/tsconfig.json",
    "generate": "tsx scripts/generate-catalog.ts --write && pnpm --workspace-root exec oxfmt --write packages/provider-registry/data/models.json packages/provider-registry/data/provider-models.json packages/provider-registry/data/providers.json packages/provider-registry/src/patterns/reasoning-families.gen.ts packages/provider-registry/src/patterns/server-tool-models.gen.ts packages/provider-registry/src/patterns/server-tool-constraints.gen.ts",
    "generate:check": "tsx scripts/generate-catalog.ts --report",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "json-schema": "^0.4.0",
    "lucide-react": "^0.563.0"
  },
  "devDependencies": {
    "@ai-sdk/provider-utils": "^4.0.40",
    "@types/json-schema": "^7.0.15",
    "@types/node": "^24.10.2",
    "dotenv": "^17.2.3",
    "tsdown": "^0.22.14",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vitest": "^4.0.13",
    "zod": "^4.1.12"
  },
  "peerDependencies": {},
  "packageManager": "pnpm@10.27.0"
}
