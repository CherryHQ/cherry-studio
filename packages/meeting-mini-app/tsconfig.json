{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "paths": {
      "@cherrystudio/ui": ["../ui/src/index.ts"],
      "@cherrystudio/ui/*": ["../ui/src/*"]
    }
  },
  "include": ["src", "vite.config.ts", "vitest.config.ts", "../../docs/references/mini-app/cherry.d.ts"]
}
