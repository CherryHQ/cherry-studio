{
  "name": "@cherrystudio/ai-core",
  "version": "2.0.1",
  "description": "Cherry Studio AI Core - Unified AI Provider Interface Based on Vercel AI SDK",
  "keywords": [
    "ai",
    "anthropic",
    "cherry-studio",
    "google",
    "openai",
    "sdk",
    "vercel-ai-sdk"
  ],
  "homepage": "https://github.com/CherryHQ/cherry-studio#readme",
  "bugs": {
    "url": "https://github.com/CherryHQ/cherry-studio/issues"
  },
  "license": "MIT",
  "author": "Cherry Studio",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CherryHQ/cherry-studio.git"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "react-native": "dist/index.mjs",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "react-native": "./dist/index.mjs",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "default": "./dist/index.mjs"
    },
    "./built-in/plugins": {
      "types": "./dist/built-in/plugins/index.d.mts",
      "react-native": "./dist/built-in/plugins/index.mjs",
      "import": "./dist/built-in/plugins/index.mjs",
      "require": "./dist/built-in/plugins/index.cjs",
      "default": "./dist/built-in/plugins/index.mjs"
    },
    "./provider": {
      "types": "./dist/provider/index.d.mts",
      "react-native": "./dist/provider/index.mjs",
      "import": "./dist/provider/index.mjs",
      "require": "./dist/provider/index.cjs",
      "default": "./dist/provider/index.mjs"
    }
  },
  "scripts": {
    "build": "tsdown",
    "clean": "rm -rf dist",
    "dev": "pnpm --workspace-root exec tsc -w -p packages/aiCore/tsconfig.json",
    "format": "pnpm --workspace-root exec oxfmt --write packages/aiCore",
    "format:check": "pnpm --workspace-root exec oxfmt --check packages/aiCore",
    "lint": "oxlint --fix",
    "lint:check": "oxlint",
    "prepublishOnly": "pnpm build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm --workspace-root exec tsc --noEmit -p packages/aiCore/tsconfig.json --composite false"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.103",
    "@ai-sdk/azure": "^3.0.54",
    "@ai-sdk/deepseek": "^2.0.30",
    "@ai-sdk/openai-compatible": "^2.0.62",
    "@ai-sdk/provider": "^3.0.14",
    "@ai-sdk/provider-utils": "^4.0.40",
    "@ai-sdk/xai": "^3.0.111",
    "@cherrystudio/ai-sdk-provider": "workspace:*",
    "@openrouter/ai-sdk-provider": "^2.10.0",
    "quick-lru": "^5.1.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@cherrystudio/ai-sdk-provider": "workspace:*",
    "@types/node": "^24.10.4",
    "oxlint": "1.76.0",
    "tsdown": "^0.22.14",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vitest": "^3.2.7"
  },
  "peerDependencies": {
    "@ai-sdk/google": "^3.0.64",
    "@ai-sdk/openai": "^3.0.53",
    "ai": "^6.0.116"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
