{
  "name": "@cherrystudio/web-core",
  "version": "0.0.0",
  "private": true,
  "description": "Core Worker host that runs the Cherry Studio data layer in the browser on SQLite-WASM and OPFS.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "sideEffects": [
    "./src/page/preload.ts",
    "./src/runtime/zodJitless.ts"
  ],
  "exports": {
    "./client": "./src/client/CoreClient.ts",
    "./worker": "./src/worker/startCoreWorker.ts"
  },
  "scripts": {
    "build:app": "cd ../.. && vite build --config packages/web-core/vite.app.config.ts",
    "build:harness": "vite build",
    "test:browser": "vite build && pnpm run build:app && playwright test",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.page.json"
  },
  "dependencies": {
    "@cherrystudio/sqlite-wasm-compat": "workspace:*",
    "@noble/hashes": "^2.4.0",
    "@zenfs/core": "^2.7.7",
    "@zenfs/dom": "^1.2.14",
    "ai": "6.0.185",
    "buffer": "^6.0.3",
    "drizzle-orm": "^0.44.5",
    "es-toolkit": "^1.49.0",
    "kerium": "^1.5.0",
    "modern-tar": "^0.8.6",
    "pathe": "^2.0.3",
    "quickjs-wasi": "3.6.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vite": "8.2.2"
  }
}
