{
  "name": "@cherrystudio/sandbox",
  "version": "0.0.1",
  "private": true,
  "description": "MXC-backed process sandbox and bidirectional RPC for Cherry Studio",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/src/host/SandboxManager.d.ts",
      "default": "./dist/src/host/SandboxManager.js"
    },
    "./types": {
      "types": "./dist/src/types.d.ts",
      "default": "./dist/src/types.js"
    },
    "./rpc": {
      "types": "./dist/src/rpc/peer.d.ts",
      "default": "./dist/src/rpc/peer.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "demo": "node examples/host.mjs",
    "demo:rpc": "node examples/rpcHost.mjs",
    "lab": "node dist/src/cli/lab.js",
    "setup:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/prepareWindows.ps1",
    "test": "pnpm build && vitest run --config vitest.config.ts",
    "test:acceptance": "pnpm build && vitest run --config vitest.acceptance.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@microsoft/mxc-sdk": "1.0.0",
    "vscode-jsonrpc": "9.0.3"
  },
  "devDependencies": {
    "@types/node": "24.10.4",
    "typescript": "5.9.3",
    "vitest": "^5.0.1"
  }
}
