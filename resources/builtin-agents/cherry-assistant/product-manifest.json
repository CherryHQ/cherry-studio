    {
      "id": "app.zoom.in",
      "titleKey": "settings.shortcuts.zoom_in",
      "categoryKey": "settings.shortcuts.general",
      "scope": "main",
      "keybinding": {
        "defaultBinding": [
          "CommandOrControl",
          "="
