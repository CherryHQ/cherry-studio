import fs from 'node:fs/promises';import path from 'node:path';import {randomUUID} from 'node:crypto';
import {search} from './core.mjs';import {formatMarkdown} from './format.mjs';import type {DesignSystem} from './design-system.mjs';
export function safeSlug(name:string,fallback='default'):string{const slug=String(name).toLowerCase().replace(/[^a-z0-9_-]+/g,'-').replace(/^-+|-+$/g,'')||fallback;return /^(con|prn|aux|nul|com[1-9]|lpt[1-9])$/i.test(slug)?`project-${slug}`:slug;}
async function inspect(file:string){try{return await fs.lstat(file);}catch(error){if((error as NodeJS.ErrnoException).code==='ENOENT')return null;throw error;}}
async function ensureDirectory(parent:string,name:string):Promise<string>{const dir=path.join(parent,name),stat=await inspect(dir);if(stat?.isSymbolicLink())throw new Error(`Linked persistence directory is not allowed: ${dir}`);if(stat&&!stat.isDirectory())throw new Error(`Persistence directory is a file: ${dir}`);if(!stat)await fs.mkdir(dir,{recursive:true});const created=await fs.lstat(dir);if(created.isSymbolicLink()||!created.isDirectory())throw new Error(`Unsafe persistence directory: ${dir}`);return dir;}
async function write(file:string,text:string,force:boolean):Promise<{written:boolean;backup?:string}>{
  const existing=await inspect(file);if(existing?.isSymbolicLink())throw new Error(`Linked persistence file is not allowed: ${file}`);if(existing&&!force)return{written:false};
  // wx is the no-overwrite authority even when another process races this writer.
  if(!force){let handle;try{handle=await fs.open(file,'wx');}catch(error){if((error as NodeJS.ErrnoException).code==='EEXIST')return{written:false};throw error;}try{await handle.writeFile(text,'utf8');await handle.sync();}finally{await handle.close();}return{written:true};}
  const temp=`${file}.${randomUUID()}.tmp`;let backup:string|undefined;
  if(existing){backup=`${file}.${randomUUID()}.backup`;await fs.copyFile(file,backup);}
  try{await fs.writeFile(temp,text,{encoding:'utf8',flag:'wx'});await fs.rename(temp,file);}finally{await fs.rm(temp,{force:true});}return{written:true,backup};
}
export function pageOverrides(page:string,query:string){const context=`${page.toLowerCase()} ${query.toLowerCase()}`,style=search(context,'style',1).results?.[0],ux=search(context,'ux',3).results??[],landing=search(context,'landing',1).results?.[0];
  const layout:Record<string,string>={},spacing:Record<string,string>={},colors:Record<string,string>={},components:string[]=[],recommendations:string[]=[];
  if(style){const keywords=style.Keywords?.toLowerCase()??'';if(['data','dense','dashboard','grid'].some(k=>keywords.includes(k))){Object.assign(layout,{'Max Width':'1400px or full-width',Grid:'12-column grid for data flexibility'});spacing['Content Density']='High — optimize for information display';}else if(['minimal','simple','clean','single'].some(k=>keywords.includes(k))){Object.assign(layout,{'Max Width':'800px (narrow, focused)',Layout:'Single column, centered'});spacing['Content Density']='Low — focus on clarity';}else Object.assign(layout,{'Max Width':'1200px (standard)',Layout:'Full-width sections, centered content'});if(style['Effects & Animation'])recommendations.push(`Effects: ${style['Effects & Animation']}`);}
  for(const row of ux){if(row.Do)recommendations.push(`${row.Category??''}: ${row.Do}`);if(row["Don't"])components.push(`Avoid: ${row["Don't"]}`);}
  if(landing){if(landing['Section Order'])layout.Sections=landing['Section Order'];if(landing['Primary CTA Placement'])recommendations.push(`CTA Placement: ${landing['Primary CTA Placement']}`);if(landing['Color Strategy'])colors.Strategy=landing['Color Strategy'];}
  if(!Object.keys(layout).length)Object.assign(layout,{'Max Width':'1200px',Layout:'Responsive grid'});if(!recommendations.length)recommendations.push('Refer to MASTER.md for all design rules','Add specific overrides as needed for this page');
  const patterns:[string[],string][]=[[['dashboard','admin','analytics','data','metrics','stats','monitor','overview'],'Dashboard / Data View'],[['checkout','payment','cart','purchase','order','billing'],'Checkout / Payment'],[['settings','profile','account','preferences','config'],'Settings / Profile'],[['landing','marketing','homepage','hero','home','promo'],'Landing / Marketing'],[['login','signin','signup','register','auth','password'],'Authentication'],[['pricing','plans','subscription','tiers','packages'],'Pricing / Plans'],[['blog','article','post','news','content','story'],'Blog / Article'],[['product','item','detail','pdp','shop','store'],'Product Detail'],[['search','results','browse','filter','catalog','list'],'Search Results'],[['empty','404','error','not found','zero'],'Empty State']];
  const bestFor=style?.['Best For']?.toLowerCase()??'';const pageType=patterns.find(([keywords])=>keywords.some(k=>context.includes(k)))?.[1]??(['dashboard','data'].some(x=>bestFor.includes(x))?'Dashboard / Data View':['landing','marketing'].some(x=>bestFor.includes(x))?'Landing / Marketing':'General');return{page_type:pageType,layout,spacing,typography:{},colors,components,unique_components:[],recommendations};
}
export function formatPage(system:DesignSystem,page:string,query:string):string{const overrides=pageOverrides(page,query);return [`# ${page.replace(/[-_]/g,' ')} Page Overrides`,'',`Project: ${system.project_name}`,'','Only approved deviations override ../MASTER.md. Project DESIGN.md remains authoritative.','',...Object.entries(overrides).flatMap(([key,value])=>[`## ${key.replaceAll('_',' ')}`,'',typeof value==='object'?JSON.stringify(value,null,2):value,''])].join('\n');}
export async function persistDesignSystem(system:DesignSystem,options:{page?:string;outputDir?:string;query?:string;force?:boolean}={}){
  const requested=path.resolve(options.outputDir??process.cwd());await fs.mkdir(requested,{recursive:true});const base=await fs.realpath(requested);
  const parent=await ensureDirectory(base,'design-system'),dir=await ensureDirectory(parent,safeSlug(system.project_name||'default')),pages=await ensureDirectory(dir,'pages'),master=path.join(dir,'MASTER.md');
  const files:string[]=[],backups:string[]=[];const masterResult=await write(master,formatMarkdown(system),options.force??false);if(masterResult.written)files.push(master);if(masterResult.backup)backups.push(masterResult.backup);
  let last=master;if(options.page){last=path.join(pages,`${safeSlug(options.page,'page')}.md`);const result=await write(last,formatPage(system,options.page,options.query??''),options.force??false);if(result.written)files.push(last);if(result.backup)backups.push(result.backup);}
  return{status:files.length?'success':'skipped_exists',design_system_dir:dir,master_file:master,created_files:files,...(backups.length?{recovery_files:backups}:{}),...(!files.length?{message:`${last} already exists and was not modified. Read prior design decisions before using --force.`}:{})};
}
