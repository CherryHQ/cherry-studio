    {
      "targetKey": "chat.input.steer_shortcut",
      "type": "PreferenceTypes.ComposerShortcut",
      "defaultValue": "VALUE: null",
      "status": "classified",
      "description": "A second send-style shortcut that, in Agent mode while the session is streaming, sends the draft straight into the running turn instead of queueing it. No stored default: the effective default is platform-dependent (Command+Enter on macOS, Ctrl+Enter elsewhere) and resolved at read time. Send / newline / steer shortcuts are mutually exclusive."
    },
    {
      "targetKey": "chat.input.newline_shortcut",
      "type": "PreferenceTypes.ComposerShortcut",
      "defaultValue": "VALUE: null",
      "status": "classified",
      "description": "The composer shortcut that inserts a line break. No stored default: resolved at read time to Shift+Enter, or Enter when the send shortcut already takes Shift+Enter. Send / newline / inject shortcuts are mutually exclusive."
    },
