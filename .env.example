NODE_OPTIONS=--max-old-space-size=8000
API_KEY="sk-xxx"
BASE_URL="https://api.siliconflow.cn/v1/"
MODEL="Qwen/Qwen3-235B-A22B-Instruct-2507"
CSLOGGER_MAIN_LEVEL=info
CSLOGGER_RENDERER_LEVEL=info
#CSLOGGER_MAIN_SHOW_MODULES=
#CSLOGGER_RENDERER_SHOW_MODULES=
# Cherry Cloud local backend; override with the deployed HTTPS origin when available.
#CHERRY_CLOUD_API_ORIGIN=http://127.0.0.1:8080
# Receive the final local login callback on a temporary 127.0.0.1 port instead of cherrystudio://.
# The local Cloud API must enable CLOUD_API_DESKTOP_LOOPBACK_CALLBACK_ENABLED.
#CHERRY_CLOUD_LOOPBACK_CALLBACK=true
# Set a unique suffix when running multiple dev instances, e.g. DevQuito.
#CS_DEV_USER_DATA_SUFFIX=
