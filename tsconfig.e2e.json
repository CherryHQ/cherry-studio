{
  "extends": "./tsconfig.web.json",
  "compilerOptions": {
    "composite": false,
    "incremental": false,
    "lib": ["ESNext", "DOM", "DOM.Iterable", "DOM.AsyncIterable"],
    "types": ["node"]
  },
  "include": [
    "tests/e2e/**/*.ts",
    "scripts/e2e/ondemand/*.ts",
    "playwright.config.ts",
    "playwright.regression.config.ts",
    "src/preload/*.d.ts"
  ]
}
