{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {},
  "env": {
    "es2022": true
  },
  "globals": {},
  "jsPlugins": [
    "@shadcn/lint",
    "./scripts/lint/copy.mjs",
    "./scripts/lint/scroll-area.mjs",
    "./scripts/lint/import-layout.mjs",
    "./scripts/lint/incremental-projection.mjs"
  ],
  "ignorePatterns": [
    "node_modules/**",
    "build/**",
    "dist/**",
    "out/**",
    "local/**",
    "tests/**",
    ".yarn/**",
    ".gitignore",
    "scripts/cloudflare-worker.js",
    "src/main/services/nutstore/sso/lib/**",
    "src/renderer/ui/**",
    "packages/**/dist",
    "native/system-speech/dist",
    "eslint.config.mjs",
    "scripts/data-classify/**"
  ],
  "options": {
    "typeAware": true
  },
  "overrides": [
    {
      "files": [
        "src/main/ai/agentSession/childTimelines.ts",
        "src/main/ai/agentSession/childArchive.ts",
        "src/main/ai/agentSession/fork/readHistoryActions.ts",
        "src/main/data/api/handlers/agentSessionMessages.ts",
        "src/main/ai/messages/ProjectionSubscriptions.ts"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "(^|/)(application|@application|AgentSessionRuntimeService|durableNativeContext|recoverDurableReplies|PiDurableRuntimeDriver|DurableBackend|pi-durable)(/|$)|/runtime/(pi|claudeCode|piDurable)/",
                "message": "Archive reads and subscriptions only access product history, checkpoints and projection sources."
              },
              {
                "regex": ".*",
                "importNames": ["application", "runtimeDriverRegistry", "createPiDurableRuntime", "openDurableStorage"],
                "message": "History readers receive only the read capability."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "packages/agent-runtime/src/textPartUpdates.ts",
        "packages/agent-runtime-pi-durable/src/previewTextAppends.ts",
        "packages/agent-runtime-pi-durable/src/toolOutputOps.ts"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "(^|/)(pi-durable|content|projection|runtime|observation|messageObservation|ThreadMessageProjection|RootMessageProjection|ChildThreadProjection)([/.]|$)",
                "message": "Preview decoding takes native operations only. Use the projection owner for snapshots and reconciliation."
              },
              {
                "regex": ".*",
                "importNames": [
                  "ThreadFeed",
                  "ThreadSnapshot",
                  "RuntimeMessage",
                  "CherryUIMessage",
                  "MessageProjection",
                  "messageObservation",
                  "applyMessageParts"
                ],
                "message": "A part operation takes one target. Reconcile a source in its owner."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["packages/agent-runtime/src/stagePartUpdate.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              { "group": ["**", "!ai", "!./contracts", "!./acceptedToolPart", "!./immutable", "!./textPartUpdates"] }
            ],
            "paths": [
              { "name": "ai", "allowImportNames": ["isToolUIPart"] },
              { "name": "./contracts", "allowImportNames": ["LivePartInput", "RuntimePart", "RuntimePartEdit"] },
              { "name": "./acceptedToolPart", "allowImportNames": ["snapshotToolPart"] },
              { "name": "./immutable", "allowImportNames": ["immutable"] },
              { "name": "./textPartUpdates", "allowImportNames": ["partEdits"] }
            ]
          }
        ]
      }
    },
    {
      "files": ["packages/agent-runtime/src/observation.ts"],
      "rules": {
        "incremental-projection/addressed-writes": ["error", ["publishPart"]]
      }
    },
    {
      "files": ["packages/agent-runtime-claude-code/src/observation.ts"],
      "rules": { "incremental-projection/addressed-writes": ["error", ["publish"]] }
    },
    {
      "files": ["src/main/ai/agentSession/ThreadMessageProjection.ts"],
      "rules": { "incremental-projection/addressed-writes": ["error", ["stageParts"]] }
    },
    {
      "files": ["src/main/ai/streamManager/TopicMessageProjection.ts"],
      "rules": { "incremental-projection/addressed-writes": ["error", ["relayAgentPart"]] }
    },
    {
      "files": ["packages/agent-runtime-claude-code/src/projection.ts"],
      "rules": { "incremental-projection/addressed-writes": ["error", ["partial", "applyResult", "deny", "spawnCall"]] }
    },
    {
      "files": ["packages/agent-runtime-pi/src/runtimeProjection.ts"],
      "rules": { "incremental-projection/addressed-writes": ["error", ["delta", "result", "nested"]] }
    },
    {
      "files": ["packages/agent-runtime-pi-durable/src/projection.ts"],
      "rules": {
        "incremental-projection/addressed-writes": [
          "error",
          ["appendPreview", "updatePreviewParts", "previewTools", "commitToolResult"]
        ]
      }
    },
    {
      "files": ["src/main/ai/agentSession/RootMessageProjection.ts"],
      "rules": { "incremental-projection/addressed-writes": ["error", ["changePart"]] }
    },
    {
      "files": ["src/main/ai/agentSession/ChildThreadProjection.ts"],
      "rules": { "incremental-projection/addressed-writes": ["error", ["applyParts"]] }
    },
    {
      "files": ["src/main/ai/messages/MessageProjection.ts"],
      "rules": {
        "incremental-projection/addressed-writes": ["error", ["queuePart", "publishParts"]]
      }
    },
    {
      "files": ["packages/agent-runtime/src/textPartUpdates.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [{ "group": ["**", "!./contracts"] }],
            "paths": [
              {
                "name": "./contracts",
                "allowImportNames": [
                  "LivePartInput",
                  "MessageObservation",
                  "NativePartUpdate",
                  "RuntimePartEdit",
                  "ObservationPayload",
                  "ProjectionEvents"
                ]
              }
            ]
          }
        ],
        "no-restricted-properties": [
          "error",
          { "property": "snapshot" },
          { "property": "readMessage" },
          { "property": "materialize" },
          { "property": "message" }
        ]
      }
    },
    {
      "files": ["src/renderer/hooks/useHistoryReplies.ts", "src/renderer/hooks/useHistoryRowUpdates.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "(^|/)(swr|DataApiService|useDataApi|useTopicMessages|useAgentSessionParts|useConversationHistoryQuery)(/|$)",
                "message": "Terminal handoff reads one committed reply through ReplyHistory."
              }
            ]
          }
        ],
        "no-restricted-properties": ["error", { "property": "refresh" }, { "property": "mutate" }]
      }
    },
    {
      "files": ["src/renderer/services/aiTransport/MessageProjectionService.ts"],
      "rules": { "incremental-projection/addressed-writes": ["error", ["commitParts"]] }
    },
    {
      "files": ["src/renderer/components/chat/messages/blocks/MessagePartsRenderer.tsx"],
      "rules": {
        "incremental-projection/addressed-writes": [
          "error",
          ["useAddressedMessageParts", "AddressedProcessHistory", "AddressedHistoryRun", "ToolPartView"]
        ]
      }
    },
    {
      "files": ["src/renderer/services/aiTransport/applyLiveParts.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "**",
                  "!@renderer/types/message",
                  "!@shared/ai/messageProjection",
                  "!@shared/data/types/message"
                ]
              }
            ],
            "paths": [
              { "name": "@renderer/types/message", "allowImportNames": ["MessageTextChange"] },
              {
                "name": "@shared/ai/messageProjection",
                "allowImportNames": ["LivePartPatch", "PartPlacement", "updatedPartValue"]
              },
              { "name": "@shared/data/types/message", "allowImportNames": ["CherryMessagePart"] }
            ]
          }
        ],
        "no-restricted-properties": [
          "error",
          { "property": "snapshot" },
          { "property": "readMessage" },
          { "property": "materialize" }
        ]
      }
    },
    {
      "files": ["src/renderer/hooks/agent/useProjectionPart.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [{ "group": ["**", "!react", "!@renderer/types/message", "!@shared/data/types/message"] }],
            "paths": [
              { "name": "@renderer/types/message", "allowImportNames": ["ProjectionPartReader"] },
              {
                "name": "react",
                "allowImportNames": ["createContext", "useCallback", "use", "useSyncExternalStore"]
              },
              { "name": "@shared/data/types/message", "allowImportNames": ["CherryMessagePart"] }
            ]
          }
        ],
        "no-restricted-properties": [
          "error",
          { "property": "snapshot" },
          { "property": "readMessage" },
          { "property": "materialize" }
        ]
      }
    },
    {
      "files": [
        "src/renderer/pages/agents/useAgentChatRuntimeState.ts",
        "src/renderer/services/voice/AutoReadService.ts"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "(^|/)MessageProjectionService(\\.[cm]?[jt]s)?$",
                "message": "Subscribe to execution snapshots and text appends through the overlay."
              },
              {
                "regex": ".*",
                "importNames": ["MessageProjectionService", "messageProjectionService"],
                "message": "Subscribe to execution snapshots and text appends through the overlay."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["**/*.test.*", "**/*.spec.*", "**/__tests__/**"],
      "rules": { "import/first": "off" }
    },
    {
      "files": [
        "**/*.test.*",
        "**/*.spec.*",
        "**/__tests__/**",
        "**/tests/**",
        "packages/provider-registry/compat/*-validator.mjs"
      ],
      "rules": { "copy/no-json-roundtrip": "off" }
    },
    {
      "files": [
        "src/renderer/**/*.{ts,tsx}",
        "packages/ui/src/**/*.{ts,tsx}",
        "packages/file-preview/src/**/*.{ts,tsx}"
      ],
      "rules": {
        "cherry-scroll-area/no-container-padding": "error",
        "shadcn/no-raw-colors": ["off", { "allow": ["outline-dot", "outline-text"] }],
        "shadcn/no-unknown-classes": [
          "off",
          {
            "allow": [
              "lucide-custom",
              "selectable",
              "message-content-container",
              "message-thought-container",
              "MessageFooter",
              "message",
              "message-user",
              "message-assistant",
              "in-popover",
              "selected",
              "multi-select-mode",
              "drag",
              "nodrag",
              "clear-context-divider",
              "source-view",
              "mini-app-icon-frame",
              "outline-dot",
              "outline-text"
            ]
          }
        ]
      }
    },
    {
      "env": {
        "node": true
      },
      "files": [
        "src/main/**",
        "resources/scripts/**",
        "scripts/**",
        "playwright.config.ts",
        "electron.vite.config.ts",
        "packages/ui/scripts/**"
      ]
    },
    {
      "env": {
        "browser": true
      },
      "files": [
        "src/renderer/**/*.{ts,tsx}",
        "packages/aiCore/**",
        "packages/extension-table-plus/**",
        "packages/file-preview/src/**",
        "packages/ui/**"
      ]
    },
    {
      "env": {
        "node": true,
        "vitest": true
      },
      "files": ["**/__tests__/*.test.{ts,tsx}", "tests/**"]
    },
    {
      "env": {
        "browser": true,
        "node": true
      },
      "files": ["src/preload/**"]
    },
    {
      "files": ["packages/ai-sdk-provider/**"],
      "globals": {
        "fetch": "readonly"
      }
    }
  ],
  "plugins": ["unicorn", "typescript", "oxc", "import"],
  "rules": {
    "copy/no-json-roundtrip": "error",
    "import/first": "error",
    "import-layout/no-block-comments-between-imports": "error",
    "no-array-constructor": "off",
    "no-caller": "error",
    "no-eval": "error",
    "no-fallthrough": "error",
    "no-restricted-globals": [
      "error",
      {
        "name": "structuredClone",
        "message": "Avoid synchronous deep copies. Prefer explicit construction or structural sharing; exceptions need a call-site lint suppression with a reason."
      }
    ],
    "no-restricted-properties": [
      "error",
      {
        "object": "globalThis",
        "property": "structuredClone",
        "message": "Avoid synchronous deep copies. Prefer explicit construction or structural sharing; exceptions need a call-site lint suppression with a reason."
      },
      {
        "object": "window",
        "property": "structuredClone",
        "message": "Avoid synchronous deep copies. Prefer explicit construction or structural sharing; exceptions need a call-site lint suppression with a reason."
      },
      {
        "object": "self",
        "property": "structuredClone",
        "message": "Avoid synchronous deep copies. Prefer explicit construction or structural sharing; exceptions need a call-site lint suppression with a reason."
      },
      {
        "object": "global",
        "property": "structuredClone",
        "message": "Avoid synchronous deep copies. Prefer explicit construction or structural sharing; exceptions need a call-site lint suppression with a reason."
      }
    ],
    "no-unassigned-vars": "error",
    "no-unused-expressions": "off",
    "no-unused-vars": ["error", { "caughtErrors": "none" }],
    "no-useless-rename": "error",
    "oxc/bad-array-method-on-arguments": "error",
    "oxc/bad-char-at-comparison": "error",
    "oxc/bad-comparison-sequence": "error",
    "oxc/bad-min-max-func": "error",
    "oxc/bad-object-literal-comparison": "error",
    "oxc/bad-replace-all-arg": "error",
    "oxc/const-comparisons": "error",
    "oxc/double-comparisons": "error",
    "oxc/erasing-op": "error",
    "oxc/missing-throw": "error",
    "oxc/number-arg-out-of-range": "error",
    "oxc/only-used-in-recursion": "off",
    "oxc/uninvoked-array-callback": "error",
    "typescript/await-thenable": "warn",
    "typescript/consistent-type-imports": "error",
    "typescript/no-array-constructor": "error",
    "typescript/no-array-delete": "error",
    "typescript/no-base-to-string": "off", // TODO: warn
    "typescript/no-duplicate-enum-values": "error",
    "typescript/no-duplicate-type-constituents": "error",
    "typescript/no-empty-object-type": "off",
    "typescript/no-explicit-any": "off",
    "typescript/no-extra-non-null-assertion": "error",
    "typescript/no-floating-promises": "error",
    "typescript/no-for-in-array": "error",
    "typescript/no-implied-eval": "off", // TODO: warn
    "typescript/no-meaningless-void-operator": "error",
    "typescript/no-misused-new": "error",
    "typescript/no-misused-spread": "off", // TODO: warn
    "typescript/no-namespace": "error",
    "typescript/no-non-null-asserted-optional-chain": "off",
    "typescript/no-redundant-type-constituents": "off", // TODO: warn
    "typescript/no-require-imports": "off",
    "typescript/no-this-alias": "error",
    "typescript/no-unnecessary-parameter-property-assignment": "error",
    "typescript/no-unnecessary-type-assertion": "error",
    "typescript/no-unnecessary-type-constraint": "error",
    "typescript/no-unsafe-declaration-merging": "error",
    "typescript/no-unsafe-function-type": "error",
    "typescript/no-unsafe-unary-minus": "error",
    "typescript/no-useless-default-assignment": "error",
    "typescript/no-useless-empty-export": "error",
    "typescript/no-wrapper-object-types": "error",
    "typescript/prefer-as-const": "error",
    "typescript/prefer-namespace-keyword": "error",
    "typescript/require-array-sort-compare": "off", // TODO: warn
    "typescript/restrict-template-expressions": "off", // TODO: warn
    "typescript/triple-slash-reference": "error",
    "typescript/unbound-method": "off", // TODO: warn
    "unicorn/no-await-in-promise-methods": "error",
    "unicorn/no-empty-file": "off",
    "unicorn/no-invalid-fetch-options": "error",
    "unicorn/no-invalid-remove-event-listener": "error",
    "unicorn/no-new-array": "off",
    "unicorn/no-single-promise-in-promise-methods": "error",
    "unicorn/no-thenable": "off",
    "unicorn/no-unnecessary-await": "error",
    "unicorn/no-useless-fallback-in-spread": "error",
    "unicorn/no-useless-length-check": "error",
    "unicorn/no-useless-spread": "off",
    "unicorn/prefer-set-size": "error",
    "unicorn/prefer-string-starts-ends-with": "error"
  },
  "settings": {
    "shadcn": {
      "ui": "@cherrystudio/ui",
      "themeImports": ["^@cherrystudio/ui/styles/"],
      "note": "See DESIGN.md and packages/ui/docs/design-token-system.md."
    },
    "jsdoc": {
      "augmentsExtendsReplacesDocs": false,
      "exemptDestructuredRootsFromChecks": false,
      "ignoreInternal": false,
      "ignorePrivate": false,
      "ignoreReplacesDocs": true,
      "implementsReplacesDocs": false,
      "overrideReplacesDocs": true,
      "tagNamePreference": {}
    },
    "jsx-a11y": {
      "attributes": {},
      "components": {},
      "polymorphicPropName": null
    },
    "next": {
      "rootDir": []
    },
    "react": {
      "formComponents": [],
      "linkComponents": []
    }
  }
}
